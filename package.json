{
  "name": "skeletage",
  "version": "1.0.0",
  "description": "Team 3 2024-2025 Senior Design project",
  "main": "./dist/App.js",
  "scripts": {
    "prettier:write": "prettier --check \"src/**/*.ts\" --ignore-path .gitignore --write \"src/**/*.ts\"",
    "build:ts": "tsc --build tsconfig.build.json",
    "build": "npm-run-all prettier:write build:ts",
    "watch": "tsc --watch",
    "install-python": "pipenv install",
    "frontend": "npm run build && electron .",
    "dev": "npm run install-python && npm run frontend",
    "prod": "npm run build && npm run make",
    "test": "jest",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Majorsaturn/Skeletal_Age_Estimation.git"
  },
  "author": "Cassidy Marquis, Matthew Hardenburg, Matthew Szmarch, Nicholas Novak",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Majorsaturn/Skeletal_Age_Estimation/issues"
  },
  "homepage": "https://github.com/Majorsaturn/Skeletal_Age_Estimation#readme",
  "devDependencies": {
    "@electron-forge/cli": "^7.8.0",
    "@electron-forge/maker-deb": "^7.8.0",
    "@electron-forge/maker-rpm": "^7.8.0",
    "@electron-forge/maker-squirrel": "^7.8.0",
    "@electron-forge/maker-zip": "^7.8.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.0",
    "@electron-forge/plugin-fuses": "^7.8.0",
    "@electron/fuses": "^1.8.0",
    "@types/electron": "^1.4.38",
    "@types/html-to-docx": "^1.8.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "electron": "^33.4.11",
    "globals": "^15.12.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "@types/xml2js": "^0.4.14",
    "concurrently": "^9.1.0",
    "docx": "^8.6.0",
    "electron-squirrel-startup": "^1.0.1",
    "html-to-docx": "^1.8.0",
    "typescript": "^5.6.3",
    "xml2js": "^0.6.2"
  }
}
